{
  "name": "@stanford-press/migrate",
  "version": "0.1.0",
  "description": "OJS 3.x database importer with migration planning, data mapping, reporting, and rollback support for Stanford Open Press.",
  "license": "MIT",
  "author": "Ahmed Allem",
  "bin": {
    "stanford-press-migrate": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@stanford-press/core": "workspace:*",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kingofmit/stanford-open-press.git",
    "directory": "packages/migrate"
  },
  "keywords": [
    "stanford-open-press",
    "migration",
    "ojs",
    "open-journal-systems",
    "import",
    "scholarly-publishing",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  }
}

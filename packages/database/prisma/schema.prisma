generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// JOURNAL & CONFIGURATION
// ============================================

model Journal {
  id            String   @id @default(cuid())
  name          String
  abbreviation  String?
  slug          String   @unique
  description   String?
  issn          String?
  eissn         String?
  doiPrefix     String?
  logoUrl       String?
  primaryLocale String   @default("en")

  // DOAJ-required policies
  licenseType     String @default("CC-BY-4.0")
  copyrightPolicy String @default("author-retains")
  peerReviewType  String @default("double-blind")
  apcAmount       Float? @default(0)
  apcCurrency     String @default("USD")

  // Theme
  primaryColor String @default("#8C1515")
  accentColor  String @default("#B1040E")
  headingFont  String @default("Source Sans 3")
  bodyFont     String @default("Source Serif 4")

  sections       JournalSection[]
  submissions    Submission[]
  issues         Issue[]
  volumes        Volume[]
  roles          RoleAssignment[]
  emailTemplates EmailTemplate[]
  reviewForms    ReviewForm[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JournalSection {
  id           String  @id @default(cuid())
  journalId    String
  journal      Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  name         String
  abbreviation String?
  description  String?
  policy       String?
  sortOrder    Int     @default(0)
  active       Boolean @default(true)

  submissions Submission[]

  @@index([journalId])
}

// ============================================
// USERS & ROLES
// ============================================

model User {
  id          String  @id @default(cuid())
  email       String  @unique
  name        String
  orcid       String? @unique
  affiliation String?
  avatarUrl   String?
  bio         String?

  roles       RoleAssignment[]
  submissions Submission[]       @relation("submitter")
  authorships Author[]
  reviews     ReviewAssignment[] @relation("reviewer")
  assignedBy  ReviewAssignment[] @relation("assigner")
  decisions   EditorialDecision[]

  // Reverse relations for editorial workflow
  editorAssignments  Submission[]       @relation("editor")
  copyeditRecords    CopyeditRecord[]   @relation("copyeditor")
  productionTasks    ProductionTask[]   @relation("productionAssignee")
  uploadedFiles      FileAttachment[]   @relation("fileUploader")
  statusChanges      StatusChange[]     @relation("statusActor")
  expertiseEmbedding ExpertiseEmbedding?
  notifications      Notification[]

  // Reviewer profile
  expertiseAreas    String[]
  avgResponseDays   Float?
  qualityScore      Float?
  totalCompleted    Int      @default(0)
  totalDeclined     Int      @default(0)
  reviewerAvailable Boolean  @default(true)
  lastReviewDate    DateTime?

  // Auth
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// NextAuth models
model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model RoleAssignment {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  journalId String
  journal   Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  role      Role

  createdAt DateTime @default(now())

  @@unique([userId, journalId, role])
  @@index([journalId])
  @@index([userId])
}

enum Role {
  EditorInChief
  ManagingEditor
  SectionEditor
  GuestEditor
  Reviewer
  Author
  Copyeditor
  Proofreader
  ProductionEditor
}

// ============================================
// SUBMISSIONS
// ============================================

model Submission {
  id        String          @id @default(cuid())
  journalId String
  journal   Journal         @relation(fields: [journalId], references: [id])
  sectionId String?
  section   JournalSection? @relation(fields: [sectionId], references: [id])

  title    String
  abstract String?
  keywords String[]
  locale   String @default("en")

  submitterId String
  submitter   User @relation("submitter", fields: [submitterId], references: [id])

  status SubmissionStatus @default(Draft)
  stage  WorkflowStage    @default(Submission)

  currentVersion Int @default(1)

  // Metadata
  conflictOfInterest String?
  funding            String?
  dataAvailability   String?
  ethicsApproval     String?
  wordCount          Int?
  coverLetter        String?

  suggestedReviewers String[]
  opposedReviewers   String[]

  // Assigned editor
  editorId String?
  editor   User?   @relation("editor", fields: [editorId], references: [id])

  // Editorial notes (private, not visible to authors)
  editorNotes String?

  // Withdrawal
  withdrawnReason String?
  withdrawnAt     DateTime?

  // License override (can override journal default)
  articleLicense String?

  // Relations
  authors       Author[]
  files         FileAttachment[]
  reviews       ReviewAssignment[]
  decisions     EditorialDecision[]
  copyedits     CopyeditRecord[]
  production    ProductionTask[]
  statusHistory StatusChange[]
  deskReviews   DeskReviewLog[]

  // Dates
  submittedAt DateTime?
  acceptedAt  DateTime?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Published article data
  doi       String? @unique
  volume    Int?
  issue     Int?
  firstPage String?
  lastPage  String?

  @@index([journalId, status, submittedAt])
  @@index([journalId, publishedAt])
  @@index([submitterId])
  @@index([editorId])
}

enum SubmissionStatus {
  Draft
  Submitted
  DeskReview
  UnderReview
  RevisionRequested
  RevisionSubmitted
  Accepted
  InCopyediting
  InProduction
  Scheduled
  Published
  Rejected
  Withdrawn
}

enum WorkflowStage {
  Submission
  DeskReview
  PeerReview
  EditorialDecision
  Revision
  Copyediting
  Production
  Published
  Rejected
}

model Author {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?      @relation(fields: [userId], references: [id])

  givenName     String
  familyName    String
  email         String
  affiliation   String?
  orcid         String?
  corresponding Boolean @default(false)
  sortOrder     Int     @default(0)

  @@index([submissionId])
}

model FileAttachment {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  filename    String
  storagePath String
  mimeType    String
  sizeBytes   Int
  category    FileCategory
  version     Int    @default(1)
  label       String?

  uploadedById String
  uploader     User     @relation("fileUploader", fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  @@index([submissionId, category])
}

enum FileCategory {
  Manuscript
  Supplementary
  Figure
  Table
  CoverLetter
  RevisedManuscript
  ResponseToReviewers
  CopyeditedManuscript
  Galley
  Proof
}

model StatusChange {
  id           String           @id @default(cuid())
  submissionId String
  submission   Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fromStatus   SubmissionStatus
  toStatus     SubmissionStatus
  actorId      String
  actor        User             @relation("statusActor", fields: [actorId], references: [id])
  comment      String?
  createdAt    DateTime         @default(now())

  @@index([submissionId])
}

// ============================================
// PEER REVIEW
// ============================================

model ReviewForm {
  id          String             @id @default(cuid())
  journalId   String
  journal     Journal            @relation(fields: [journalId], references: [id], onDelete: Cascade)
  name        String
  description String?
  active      Boolean            @default(true)
  criteria    ReviewCriteria[]
  assignments ReviewAssignment[]
  createdAt   DateTime           @default(now())

  @@index([journalId])
}

model ReviewCriteria {
  id           String        @id @default(cuid())
  formId       String
  form         ReviewForm    @relation(fields: [formId], references: [id], onDelete: Cascade)
  label        String
  description  String?
  minScore     Int           @default(1)
  maxScore     Int           @default(5)
  weight       Float         @default(1)
  required     Boolean       @default(true)
  sortOrder    Int           @default(0)
  reviewScores ReviewScore[]

  @@index([formId])
}

model ReviewAssignment {
  id           String                 @id @default(cuid())
  submissionId String
  submission   Submission             @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewer     User                   @relation("reviewer", fields: [reviewerId], references: [id])
  assignedById String
  assignedBy   User                   @relation("assigner", fields: [assignedById], references: [id])

  formId     String?
  form       ReviewForm?            @relation(fields: [formId], references: [id])
  reviewType ReviewType             @default(DoubleBlind)
  round      Int                    @default(1)

  status   ReviewAssignmentStatus @default(Invited)
  deadline DateTime

  // Review content (Json kept for backward compatibility)
  scores             Json?
  reviewScores       ReviewScore[]
  commentsToAuthor   String?
  commentsToEditor   String?
  recommendation     ReviewDecision?

  declineReason String?

  // Token for email-based accept/decline (no login needed to decline)
  invitationToken String? @unique

  invitedAt   DateTime  @default(now())
  respondedAt DateTime?
  completedAt DateTime?

  @@index([submissionId, round])
  @@index([reviewerId, status])
}

model ReviewScore {
  id           String           @id @default(cuid())
  assignmentId String
  assignment   ReviewAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  criterionId  String
  criterion    ReviewCriteria   @relation(fields: [criterionId], references: [id])
  score        Int
  comment      String?

  @@unique([assignmentId, criterionId])
  @@index([assignmentId])
}

enum ReviewType {
  SingleBlind
  DoubleBlind
  Open
}

enum ReviewAssignmentStatus {
  Invited
  Accepted
  Declined
  InProgress
  Completed
  Overdue
  Cancelled
}

enum ReviewDecision {
  Accept
  MinorRevision
  MajorRevision
  Reject
}

// ============================================
// EDITORIAL
// ============================================

model EditorialDecision {
  id           String                @id @default(cuid())
  submissionId String
  submission   Submission            @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  editorId     String
  editor       User                  @relation(fields: [editorId], references: [id])

  decision EditorialDecisionType
  round    Int                   @default(1)

  commentsToAuthor String?
  internalNotes    String?

  createdAt DateTime @default(now())

  @@index([submissionId])
}

enum EditorialDecisionType {
  Accept
  MinorRevision
  MajorRevision
  Reject
  DeskReject
  Resubmit
}

model CopyeditRecord {
  id           String         @id @default(cuid())
  submissionId String
  submission   Submission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  copyeditorId String
  copyeditor   User           @relation("copyeditor", fields: [copyeditorId], references: [id])
  status       CopyeditStatus @default(Assigned)
  notes        Json?

  assignedAt  DateTime @default(now())
  completedAt DateTime?

  @@index([submissionId])
}

enum CopyeditStatus {
  Assigned
  InProgress
  AuthorReview
  Completed
}

model ProductionTask {
  id           String               @id @default(cuid())
  submissionId String
  submission   Submission           @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  type         ProductionTaskType
  assigneeId   String?
  assignee     User?                @relation("productionAssignee", fields: [assigneeId], references: [id])
  status       ProductionTaskStatus @default(Pending)
  notes        String?
  sortOrder    Int                  @default(0)

  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@index([submissionId])
}

enum ProductionTaskType {
  MetadataEntry
  Typesetting
  GalleyProof
  AuthorProofing
  FinalCheck
  DOIRegistration
}

enum ProductionTaskStatus {
  Pending
  InProgress
  AwaitingApproval
  Completed
  Skipped
}

// ============================================
// EMAIL
// ============================================

model EmailTemplate {
  id        String  @id @default(cuid())
  journalId String
  journal   Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  eventKey  String
  subject   String
  body      String
  enabled   Boolean @default(true)

  @@unique([journalId, eventKey])
}

model EmailLog {
  id           String   @id @default(cuid())
  journalId    String
  submissionId String?
  templateKey  String
  toEmail      String
  subject      String
  sentAt       DateTime @default(now())
  status       String

  @@index([journalId])
  @@index([submissionId])
}

// ============================================
// PUBLISHING
// ============================================

model Volume {
  id        String  @id @default(cuid())
  journalId String
  journal   Journal @relation(fields: [journalId], references: [id])
  number    Int
  year      Int
  title     String?
  issues    Issue[]

  @@unique([journalId, number])
}

model Issue {
  id            String    @id @default(cuid())
  journalId     String
  journal       Journal   @relation(fields: [journalId], references: [id])
  volumeId      String?
  volume        Volume?   @relation(fields: [volumeId], references: [id])
  number        Int
  title         String?
  description   String?
  coverImageUrl String?
  articleIds    String[]

  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([journalId, volumeId, number])
}

// ============================================
// AI
// ============================================

model ExpertiseEmbedding {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  areas     String[]
  embedding Float[]
  keywords  String[]
  updatedAt DateTime @updatedAt
}

model DeskReviewLog {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  assessment   String
  confidence   Float
  checks       Json
  summary      String
  reviewedAt   DateTime   @default(now())

  @@index([submissionId])
}

// ============================================
// MIGRATION
// ============================================

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String   // e.g., "submission.status", "review.invited", "decision.made"
  title        String
  message      String
  link         String?  // URL to navigate to when clicked
  read         Boolean  @default(false)
  journalId    String?
  submissionId String?
  createdAt    DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ============================================
// MIGRATION
// ============================================

model MigrationLog {
  id           String    @id @default(cuid())
  sourceSystem String
  planData     Json
  reportData   Json?
  idMapping    Json?
  status       String
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
}

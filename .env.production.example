# ============================================
# Stanford Open Press — Production Environment
# ============================================
# Copy this file to .env.production and fill in your values:
#   cp .env.production.example .env.production

# ---- Required ----
POSTGRES_PASSWORD=your-strong-database-password
NEXTAUTH_URL=https://press.yourdomain.com
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ---- ORCID OAuth ----
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM=noreply@press.yourdomain.com

# ---- AI (optional) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- MinIO / S3 ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your-strong-minio-password

# ---- Cron ----
CRON_SECRET=generate-a-random-secret

# ---- Crossref (optional) ----
CROSSREF_USERNAME=
CROSSREF_PASSWORD=
CROSSREF_DEPOSITOR_NAME=Stanford Open Press
CROSSREF_DEPOSITOR_EMAIL=
CROSSREF_REGISTRANT=Stanford University

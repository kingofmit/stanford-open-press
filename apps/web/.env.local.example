DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stanford_press?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-change-in-production"

# ORCID OAuth
ORCID_CLIENT_ID=""
ORCID_CLIENT_SECRET=""

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="noreply@press.stanford.edu"

# AI / LLM (optional — features degrade gracefully without these)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-20250514"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"

# Crossref DOI Registration (optional)
CROSSREF_USERNAME=""
CROSSREF_PASSWORD=""
CROSSREF_DEPOSITOR_NAME="Stanford Open Press"
CROSSREF_DEPOSITOR_EMAIL=""
CROSSREF_REGISTRANT="Stanford University"

# File Storage (defaults to local ./uploads if not set)
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
UPLOAD_DIR="./uploads"

# Cron Jobs
CRON_SECRET=""

# PDF Generation (optional)
PUPPETEER_NO_SANDBOX="false"
